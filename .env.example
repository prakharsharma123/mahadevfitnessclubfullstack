# Copy this file to .env for local development (never commit the real .env)

SECRET_KEY=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Postgres connection string from Neon.tech (free tier). Leave unset to
# fall back to a local SQLite file for local development only.
DATABASE_URL=

# GitHub photo storage (see DEPLOYMENT_GUIDE.md)
GITHUB_TOKEN=
GITHUB_REPO=your-username/gym-photos
GITHUB_BRANCH=main

# Google sign-in for members (see docs/GOOGLE_OAUTH_GUIDE.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret word inside the gym QR code. Anyone who does not have the QR cannot mark attendance.
# Pick something random, e.g. mahadev-7x2k9q
GYM_QR_KEY=

# Instant owner alerts on Telegram (see docs/TELEGRAM_GUIDE.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
